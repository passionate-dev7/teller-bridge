# Copy to .env. scripts/genkeys.mjs fills the key lines for you; never paste a key into chat or a commit.
NETWORK=testnet            # testnet = chipnet + Base Sepolia, mainnet = BCH mainnet + Base
BASE_RPC_URL=              # optional, defaults to the public RPC of the selected network
DEPLOYER_EVM_KEY=          # generated by scripts/genkeys.mjs
DESK_EVM_KEY=              # generated by scripts/genkeys.mjs
DESK_BCH_KEY=              # generated by scripts/genkeys.mjs
# Set by Kamal: WalletConnect / Reown Cloud project id (cloud.reown.com), used by the web app build
VITE_REOWN_PROJECT_ID=
# URL of the desk counterparty service the web app talks to
VITE_DESK_URL=http://127.0.0.1:8787
# Optional: NEAR Intents 1Click partner JWT (quotes work without it)
ONECLICK_JWT=
